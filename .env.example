# SwarmSRE Control Plane Environment Variables

# --- LLM Providers ---
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- MCP Server ---
MCP_SERVER_URL=http://localhost:3000

# --- K8s Event Watcher ---
SWARMSRE_WATCHER_ENABLED=false

# --- Database ---
# Set DATABASE_URL to use PostgreSQL (recommended for production).
# If unset, the system falls back to local SQLite.
DATABASE_URL=postgresql://swarmsre:swarmsre-dev@localhost:5432/swarmsre
# AUDIT_SQLITE_PATH=/tmp/swarmsre/audit.db  # Override SQLite path (dev only)

