# SwarmSRE Control Plane Environment Variables

# --- LLM Providers ---
# Orchestrator Config (For complex reasoning)
ORCHESTRATOR_PROVIDER=google
ORCHESTRATOR_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=your_google_api_key_here

# Worker Config (For fast extraction)
WORKER_PROVIDER=groq
WORKER_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here

# Alternative Providers (Uncomment and configure to use)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OLLAMA_API_BASE=http://localhost:11434

# --- MCP Server ---
MCP_SERVER_URL=http://localhost:3000

# --- K8s Event Watcher ---
SWARMSRE_WATCHER_ENABLED=false

# --- Database (PostgreSQL — required) ---
DATABASE_URL=postgresql://swarmsre:swarmsre-dev@localhost:5432/swarmsre

# --- Slack ---
SLACK_WEBHOOK_URL=
